# ==========================================================
# MONGODB
# ==========================================================
# Lua chon 1: MongoDB chay trong Docker (mac dinh, khong can internet)
MONGODB_URI=mongodb://shrimp_app:shrimp_pass@mongodb:27017/shrimpwatch?authSource=shrimpwatch
# Lua chon 2: MongoDB Atlas tren Cloud (thay <user>, <password>, <cluster> bang thong tin cua ban)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shrimpwatch

# ==========================================================
# DATADOG (lay tai Organization Settings -> API Keys / Application Keys)
# ==========================================================
DD_API_KEY=your_datadog_api_key_here
DD_APP_KEY=your_datadog_app_key_here
DD_SITE=datadoghq.com
DD_ENV=development
DD_SERVICE=shrimpwatch
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true

# ==========================================================
# MO PHONG TRANG TRAI
# ==========================================================
FARM_ID=farm-001
FARM_NAME=ShrimpWatch Demo Farm
NUM_PONDS=6
SIMULATOR_INTERVAL_SEC=30
API_URL=http://api:8000

PYTHONUNBUFFERED=1
